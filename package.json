{
  "name": "@zeimu-ai/open-journal-rules",
  "version": "0.10.1",
  "description": "日本の税務仕訳ルール オープンソースデータセット",
  "main": "rules/journal-rules.json",
  "files": [
    "rules/",
    "schemas/",
    "dist/"
  ],
  "exports": {
    ".": "./rules/journal-rules.json",
    "./rules/*": "./rules/*",
    "./schemas/*": "./schemas/*",
    "./matcher": {
      "types": "./dist/matcher.d.ts",
      "default": "./dist/matcher.js"
    },
    "./normalize": {
      "types": "./dist/normalize.d.ts",
      "default": "./dist/normalize.js"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "default": "./dist/resolver.js"
    },
    "./entity": {
      "types": "./dist/entity.d.ts",
      "default": "./dist/entity.js"
    }
  },
  "engines": {
    "node": ">=14.13.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeimu-ai/open-journal-rules"
  },
  "keywords": [
    "accounting",
    "journal-entry",
    "japan",
    "tax",
    "freee"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:urls": "vitest run tests/urls.test.ts",
    "test:freshness": "vitest run tests/freshness.test.ts",
    "test:all": "vitest run",
    "generate-docs": "tsx scripts/generate-sources.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
