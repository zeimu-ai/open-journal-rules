{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "申告・納付期限データセット",
  "type": "object",
  "required": ["items"],
  "properties": {
    "_meta": { "type": "object" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "value", "effectiveFrom", "citations"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "category": { "type": "string" },
          "value": { "type": "string", "minLength": 1 },
          "effectiveFrom": { "type": "string", "format": "date" },
          "effectiveTo": { "type": ["string", "null"] },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "url", "verified_at"],
              "properties": {
                "source": { "type": "string", "minLength": 1 },
                "title": { "type": "string" },
                "url": { "type": "string" },
                "verified_at": { "type": "string", "format": "date" },
                "evidenceQuote": { "type": "string" },
                "authority_level": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
