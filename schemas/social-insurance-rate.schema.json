{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "社会保険料率データセット",
  "type": "object",
  "required": ["rates"],
  "properties": {
    "_meta": { "type": "object" },
    "rates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "insuranceType", "scope", "effectiveFrom", "citations"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "insuranceType": {
            "type": "string",
            "enum": ["厚生年金", "健康保険", "介護保険", "雇用保険", "子ども子育て拠出金"]
          },
          "scope": { "type": "string", "enum": ["national", "prefecture"] },
          "prefecture": { "type": "string" },
          "rateTotalPercent": { "type": ["number", "null"] },
          "rateEmployeePercent": { "type": ["number", "null"] },
          "rateEmployerPercent": { "type": ["number", "null"] },
          "effectiveFrom": { "type": "string", "format": "date", "description": "適用開始日 YYYY-MM-DD（pitto DB rule_versions.effective_from 互換）" },
          "effectiveTo": { "type": ["string", "null"], "description": "適用終了日 YYYY-MM-DD（無期限は null）" },
          "notes": { "type": "string" },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "url", "verified_at", "evidenceQuote"],
              "properties": {
                "source": { "type": "string", "minLength": 1 },
                "number": { "type": "string" },
                "title": { "type": "string" },
                "url": { "type": "string" },
                "verified_at": { "type": "string", "format": "date" },
                "evidenceQuote": { "type": "string", "minLength": 1 },
                "authority_level": {
                  "type": "string",
                  "enum": ["statute", "cabinet_order", "ministerial_ordinance", "notice", "public_rate_table", "tax_answer", "reference"]
                }
              }
            }
          }
        }
      }
    }
  }
}
