{
  "type": "object",
  "required": ["targetEntity", "applicableTaxMethods", "defaultTaxMethod", "note"],
  "properties": {
    "targetEntity": {
      "type": "string",
      "enum": ["individual", "corporation", "both"],
      "description": "本データセットが主対象とする事業主体。個別ルール/科目の applicableEntity がこれを上書きする。"
    },
    "applicableTaxMethods": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["原則課税", "簡易課税", "2割特例"] },
      "description": "本データセットが想定する消費税の課税方式。"
    },
    "defaultTaxMethod": {
      "type": "string",
      "enum": ["原則課税", "簡易課税", "2割特例"],
      "description": "既定の課税方式。各ルールの taxCategory はこの前提で付与されている。"
    },
    "note": { "type": "string" }
  },
  "additionalProperties": false
}
