{
  "type": "object",
  "required": ["id", "name", "patterns", "matchType", "accountName", "taxCategory", "confidence", "sourceUrl", "citations"],
  "properties": {
    "id": { "type": "string", "pattern": "^(rule-\\d+|tmpl-[a-z]+-\\d+)$" },
    "name": { "type": "string", "minLength": 1 },
    "patterns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "matchType": { "type": "string", "enum": ["exact", "prefix", "partial"] },
    "accountName": { "type": "string", "minLength": 1 },
    "taxCategory": { "type": "string", "enum": ["課税仕入10%", "課税仕入8%（軽減税率）", "課税売上10%", "非課税", "不課税", "免税"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sourceUrl": { "type": "string" },
    "notes": { "type": "string" },
    "priority": { "type": "integer" },
    "excludePatterns": { "type": "array", "items": { "type": "string" } },
    "invoiceRequired": { "type": "boolean" },
    "transitionalDeductionRate": { "type": ["number", "null"] },
    "applicableEntity": {
      "type": "string",
      "enum": ["individual", "corporation", "both"],
      "default": "both",
      "description": "適用される事業主体。individual=個人事業主のみ / corporation=法人のみ / both=両方。フィールド未存在時はエンジン側で both とみなす。"
    },
    "applicableYear": {
      "type": "object",
      "required": ["from"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2})?$", "description": "適用開始年月。YYYY または YYYY-MM" },
        "to": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2})?$", "description": "適用終了年月。YYYY または YYYY-MM（月は 01–12 を想定）" },
            { "type": "null", "description": "null = 現在も有効（終端なし）" }
          ]
        }
      },
      "description": "ルールの適用期間。未存在は全期間有効。経過措置等の期間限定ルールに付与。"
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "number", "url", "verified_at"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "number": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "verified_at": { "type": "string", "format": "date" },
          "reason": { "type": "string" },
          "authority_level": { "type": "string", "enum": ["statute", "ministerial_ordinance", "notice", "tax_answer", "administrative_form"] }
        }
      }
    }
  },
  "additionalProperties": false
}
