{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "源泉徴収 税率・算出方式データセット",
  "type": "object",
  "required": ["rates"],
  "properties": {
    "_meta": { "type": "object" },
    "rates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "effectiveFrom", "method", "verified", "citations"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "insuranceType": { "type": "string" },
          "scope": { "type": "string" },
          "effectiveFrom": { "type": "string", "format": "date" },
          "effectiveTo": { "type": ["string", "null"] },
          "method": {
            "type": "string",
            "enum": ["tiered_rate", "surcharge_on_income_tax", "rate_table_lookup", "tax_table_lookup"]
          },
          "statuteNumber": { "type": "string" },
          "rateTotalPercent": { "type": ["number", "null"] },
          "brackets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rate"],
              "properties": {
                "label": { "type": "string" },
                "lowerBound": { "type": "number" },
                "upperBound": { "type": "number" },
                "rate": { "type": "number" },
                "formula": { "type": "string" }
              }
            }
          },
          "combinedExamples": { "type": "array" },
          "notes": { "type": "string" },
          "verified": { "type": "boolean" },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "url", "verified_at"],
              "properties": {
                "source": { "type": "string", "minLength": 1 },
                "number": { "type": "string" },
                "title": { "type": "string" },
                "url": { "type": "string" },
                "verified_at": { "type": "string", "format": "date" },
                "evidenceQuote": { "type": "string" },
                "authority_level": {
                  "type": "string",
                  "enum": ["statute", "cabinet_order", "ministerial_ordinance", "notice", "public_rate_table", "tax_answer", "reference"]
                }
              }
            }
          }
        }
      }
    }
  }
}
