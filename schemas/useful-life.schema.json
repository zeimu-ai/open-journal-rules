{
  "type": "object",
  "required": ["description", "assets", "citation"],
  "properties": {
    "description": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category", "item", "usefulLifeYears"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "item": { "type": "string", "minLength": 1 },
          "usefulLifeYears": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "number", "url", "verified_at"],
      "properties": {
        "source": { "type": "string" },
        "number": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "verified_at": { "type": "string", "format": "date" },
        "authority_level": { "type": "string", "enum": ["statute", "ministerial_ordinance", "notice", "tax_answer", "administrative_form"] }
      }
    }
  },
  "additionalProperties": false
}
